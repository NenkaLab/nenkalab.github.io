{
  "name": "nenkalab.github.io",
  "version": "1.0.0",
  "description": "NenkaLab의 개인 블로그 웹사이트",
  "main": "index.js",
  "scripts": {
    "build:css": "postcss ./assets/css/input.css -o ./assets/css/output.css",
    "watch:css": "postcss ./assets/css/input.css -o ./assets/css/output.css --watch",

    "bify:sha": "browserify assets/js/build/sha.js -s ShaHelper -o assets/js/sha.js",
    "bify:sha-file": "browserify assets/js/build/sha-file.js -s FileShaHelper -o assets/js/sha-file.js",
    "bify:encoding": "browserify assets/js/build/encoding.js -s EncodingHelper -o assets/js/encoding.js",
    "build:js": "npm run bify:sha && npm run bify:sha-file && npm run bify:encoding"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/postcss": "^4.1.15",
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.0",
    "browserify": "^17.0.1",
    "buffer": "^6.0.3",
    "crypto-js": "^4.2.0",
    "cssnano": "^7.0.6",
    "iconv-lite": "^0.7.0",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^4.1.15"
  },
  "author": "NenkaLab",
  "license": "ISC"
}
